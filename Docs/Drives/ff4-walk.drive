# FF4: land on a map, walk north for a few seconds and back, then quit - for camera and
# rendering checks with --screenshot-dir / --screenshot-every.
#   OpenFF.exe --game=ff4 --map=d02_01 --drive=Docs/Drives/ff4-walk.drive --screenshot-dir=shots --screenshot-every=2
until jump: ff4 60
wait 6
press Up 2500
wait 2
press Left 1500
wait 2
press Down 2500
wait 2
say walk done
quit
