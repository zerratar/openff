<Project Sdk="Microsoft.NET.Sdk">

  <!-- The updater: a small native program (no .NET needed to run it), so the game can run it from a copy in
       the temp folder and it can replace everything in the install folder - the runtime's files and itself too. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>OpenFF.Updater</AssemblyName>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
    <RootNamespace>OpenFF.Updater</RootNamespace>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <OptimizationPreference>Size</OptimizationPreference>
    <StackTraceSupport>false</StackTraceSupport>
  </PropertyGroup>

</Project>
