<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Rogue Mode sample: FF3 as a run-based roguelite. Build it into the client's mods folder and start
       the client (Rogue Mode is on the title):

         dotnet build Samples/Rogue -o "<client>/mods/Rogue"

       (mod.json, rogue/ and menus/ are copied along.) Core/ is the run without the engine; Tests/ checks it. -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Rogue</AssemblyName>
    <RootNamespace>Rogue</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <DebugType>portable</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Tests/**" />
    <None Remove="Tests/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Private=false: the engine assembly is the client's; it is never copied into a mod. -->
    <ProjectReference Include="..\..\OpenFF.Engine\OpenFF.Engine.csproj" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="mod.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="rogue/**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="menus/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="DropEngineCopies" AfterTargets="Build">
    <ItemGroup>
      <EngineCopies Include="$(OutDir)OpenFF.Engine.*" />
    </ItemGroup>
    <Delete Files="@(EngineCopies)" />
  </Target>

</Project>
