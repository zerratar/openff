<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace></RootNamespace>
    <AssemblyName>OpenFF</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>0.1.3</Version>
    <Authors>OpenFF contributors</Authors>
    <Copyright>Final Fantasy III and IV are Square Enix's; this is a fan-made client and editor that read the copies you own</Copyright>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>AnyCPU;x64</Platforms>
    <ApplicationIcon></ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup>
    <!-- The game's own logic keeps its original shape; the compiler is right about most of
         these, but fixing them would mean diverging from it for no behavioural gain. -->
    <NoWarn>$(NoWarn);CS0108;CS0114;CS0162;CS0164;CS0168;CS0169;CS0219;CS0414;CS0472;CS0649;CS0652;CS1717;CS0078;CS0728;SYSLIB0011</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- The OpenFF engine: the assembly mods reference; the client hosts it (Compat/EngineHost.cs). -->
    <ProjectReference Include="..\OpenFF.Engine\OpenFF.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FontStashSharp.MonoGame" Version="1.5.8" />
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.5.1" />
    <PackageReference Include="NVorbis" Version="0.10.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- The two string tables, embedded under a fixed name; the accessors in Resources/ read them by it. -->
    <EmbeddedResource Update="Resources\Strings.resx"><LogicalName>OpenFF.Resources.Strings.resources</LogicalName></EmbeddedResource>
    <EmbeddedResource Update="Resources\Language.resx"><LogicalName>OpenFF.Resources.Language.resources</LogicalName></EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- Shared source: one implementation of the archive format, compiled into both
         the game and the editor so the reader and the extractor cannot drift. -->
    <Compile Include="..\Shared\ArchiveFormat.cs" Link="Compat\ArchiveFormat.cs" />
    <Compile Include="..\Shared\Content\*.cs" Link="Compat\Content\%(Filename)%(Extension)" />
    <Compile Include="..\Shared\Script\*.cs" Link="Compat\Script\%(Filename)%(Extension)" />
    <Compile Include="..\Shared\Script\Ffs\*.cs" Link="Compat\Script\Ffs\%(Filename)%(Extension)" />
    <Compile Include="..\Shared\Text\*.cs" Link="Compat\Text\%(Filename)%(Extension)" />
    <Compile Include="..\Shared\Data\*.cs" Link="Compat\Data\%(Filename)%(Extension)" />
    <Compile Include="..\Shared\Graphics\*.cs" Link="Compat\Graphics\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- OpenFF's own data: the phone cell geometry for Steam's sheets (Tools/gen_steam_cells.py). -->
    <None Include="Data\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
