<?xml version="1.0" encoding="utf-8"?>
<!--
  FF4's battle HUD (OpenFF.Client.Ff4Battle draws it through LayoutScreen). Written in Steam's 1080p pixels - the
  places and sizes measured off the Steam game's frames - and drawn stretched onto the client's 800 x 480. Its look is
  in styles/ff4_battle_hud.css.

  A mod reshapes it with menus/hud/ff4_battle_hud.xml (a copy of this, changed), or restyles it with
  menus/hud/styles/*.css alone. Everything binds to the root "battle" (Ff4Battle.HudData):
    battle.panel            the panel is up (false while the result fades in and out)
    battle.commands         the command window is open: a member chooses
    battle.command[0..3]    present, name, lit (the hand on it), disabled
    battle.scroll           shown, top and size (percent of the track: the rows in view)
    battle.party            the party's rows are shown (not while a foe is picked)
    battle.member[0..4]     present, name, hp, maxHp, mp, showMp, gauge (0..100), fill (1 grey while it fills, 2 yellow once full), alive,
                            low, acting (their turn to choose), picked (the hand on them)
    battle.keys             the keys' hints are shown
    battle.targets          the foes are listed for a pick: battle.target[0..3] present, name, sub (the chance to hit,
                            or the spell's name), lit
    battle.card             shown, name, hp: the picked foe's card
    battle.grid             shown, mp, maxMp, showMp, cell[0..11] (present, name, value: a spell's cost or how many of
                            an item, can, lit), scroll (shown, top, size)
    battle.message          FF4's help line at the top, or ""
    battle.result           shown, panel (0..100: it fades in with the screens), gilFound, newTotal (counting up),
                            showGil, exp, showExp, arrow, lines[0..4], lineCount
-->
