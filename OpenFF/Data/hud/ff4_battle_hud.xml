        <id>cell11</id><x>1067</x><y>303</y><width>524</width><height>95</height>
        <frame class="cell-name" bind-text="{name}"><id>name</id><x>96</x><y>29</y><width>380</width><height>45</height></frame>
        <frame class="cell-value" bind-text="{value}"><id>value</id><x>0</x><y>36</y><width>500</width><height>40</height></frame>
        <frame class="cell-hand" bind-visible="lit"><id>hand</id><x>77</x><y>31</y><width>1</width><height>1</height></frame>
      </frame>
      <frame bind-display="battle.grid.scroll.shown" class="grid-track">
        <id>track</id><x>1594</x><y>13</y><width>7</width><height>373</height>
        <frame class="grid-knob" bind-style="top: {battle.grid.scroll.top}%; height: {battle.grid.scroll.size}%"><id>knob</id><x>0</x><y>0</y><width>7</width><height>373</height></frame>
      </frame>
    </frame>

    <!-- The keys, over the party's rows: "C Auto battle  M Run away". -->
    <frame bind-display="battle.keys">
      <id>keys</id>
      <x>1210</x><y>695</y><width>600</width><height>52</height>
      <frame class="key-cap"><id>auto_key</id><x>0</x><y>0</y><width>55</width><height>52</height><data>C</data></frame>
      <frame class="key-label"><id>auto</id><x>70</x><y>0</y><width>220</width><height>52</height><data>Auto battle</data></frame>
      <frame class="key-cap"><id>run_key</id><x>273</x><y>0</y><width>55</width><height>52</height><data>M</data></frame>
      <frame class="key-label"><id>run</id><x>343</x><y>0</y><width>220</width><height>52</height><data>Run away</data></frame>
    </frame>
  </frame>

  <!-- FF4's help line: an ability's name, at the top. -->
  <frame bind-display="battle.message">
    <id>message</id>
    <x>560</x><y>27</y><width>800</width><height>76</height>
    <frame class="message-text" bind-text="{battle.message}"><id>text</id><x>0</x><y>0</y><width>800</width><height>76</height></frame>
  </frame>

  <!-- The result (btl::BattleWin): one panel across the top - the gil found and the new total on the left, the
       experience on the right, the page arrow - and below it what else the fight brought. -->
  <frame bind-display="battle.result.shown" bind-style="opacity: {battle.result.panel}%">
    <id>result</id>
    <x>150</x><y>3</y><width>1620</width><height>157</height>
    <frame class="result-label"><id>gil_label</id><x>192</x><y>33</y><width>260</width><height>50</height><data>Gil Found</data></frame>
    <frame class="result-label"><id>total_label</id><x>192</x><y>87</y><width>260</width><height>50</height><data>New Total</data></frame>
    <frame class="result-label"><id>exp_label</id><x>838</x><y>33</y><width>160</width><height>50</height><data>EXP</data></frame>
    <frame class="result-value" bind-visible="battle.result.showGil" bind-text="{battle.result.gilFound}"><id>gil</id><x>469</x><y>33</y><width>300</width><height>50</height></frame>
    <frame class="result-value" bind-visible="battle.result.showGil" bind-text="{battle.result.newTotal}"><id>total</id><x>469</x><y>87</y><width>300</width><height>50</height></frame>
    <frame class="result-value" bind-visible="battle.result.showExp" bind-text="{battle.result.exp}"><id>exp</id><x>1000</x><y>33</y><width>300</width><height>50</height></frame>
    <frame class="page-arrow" bind-visible="battle.result.arrow"><id>arrow</id><x>1552</x><y>112</y><width>1</width><height>40</height></frame>
  </frame>
  <frame bind-display="battle.result.lineCount &gt; 0">
    <id>result_lines</id>
    <x>150</x><y>187</y><width>1620</width><height>290</height>
    <frame class="result-line" bind-display="battle.result.lineCount &gt; 0" bind-text="{battle.result.lines[0]}"><id>line0</id><x>192</x><y>16</y><width>1400</width><height>54</height></frame>
    <frame class="result-line" bind-display="battle.result.lineCount &gt; 1" bind-text="{battle.result.lines[1]}"><id>line1</id><x>192</x><y>70</y><width>1400</width><height>54</height></frame>
    <frame class="result-line" bind-display="battle.result.lineCount &gt; 2" bind-text="{battle.result.lines[2]}"><id>line2</id><x>192</x><y>124</y><width>1400</width><height>54</height></frame>
    <frame class="result-line" bind-display="battle.result.lineCount &gt; 3" bind-text="{battle.result.lines[3]}"><id>line3</id><x>192</x><y>178</y><width>1400</width><height>54</height></frame>
    <frame class="result-line" bind-display="battle.result.lineCount &gt; 4" bind-text="{battle.result.lines[4]}"><id>line4</id><x>192</x><y>232</y><width>1400</width><height>54</height></frame>
  </frame>
</menu>
