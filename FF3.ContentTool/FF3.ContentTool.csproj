<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>FF3.ContentTool</RootNamespace>
    <AssemblyName>ff3content</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shared source: one implementation of the archive format, compiled into both
         the game and the content tool so the reader and the extractor cannot drift. -->
    <Compile Include="..\Shared\ArchiveFormat.cs" Link="Formats\ArchiveFormat.cs" />
    <Compile Include="..\Shared\Content\*.cs" Link="Formats\Content\%(Filename)%(Extension)" />
    <Compile Include="..\Shared\Script\*.cs" Link="Formats\Script\%(Filename)%(Extension)" />
    <!-- The game's own Shift-JIS tables, so text written by the tool decodes
         back through the game's decoder unchanged. -->
    <Compile Include="..\FF3.Game\Sjis.cs" Link="Formats\Sjis.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The editor serves these; they have to sit next to the exe. -->
    <None Include="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
