<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Crystal</RootNamespace>
    <AssemblyName>crystal</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>0.1.5</Version>
    <Authors>OpenFF contributors</Authors>
    <Copyright>Final Fantasy III and IV are Square Enix's; this is a fan-made client and editor that read the copies you own</Copyright>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shared source: one implementation of the archive format, compiled into both
         the game and the content tool so the reader and the extractor cannot drift. -->
    <Compile Include="..\Shared\ArchiveFormat.cs" Link="Formats\ArchiveFormat.cs" />
    <Compile Include="..\Shared\Content\*.cs" Link="Formats\Content\%(Filename)%(Extension)" />
    <Compile Include="..\Shared\Script\*.cs" Link="Formats\Script\%(Filename)%(Extension)" />
    <Compile Include="..\Shared\Script\Ffs\*.cs" Link="Formats\Script\Ffs\%(Filename)%(Extension)" />
    <Compile Include="..\Shared\Text\*.cs" Link="Formats\Text\%(Filename)%(Extension)" />
    <Compile Include="..\Shared\Data\*.cs" Link="Formats\Data\%(Filename)%(Extension)" />
    <Compile Include="..\Shared\Graphics\*.cs" Link="Formats\Graphics\%(Filename)%(Extension)" />
    <!-- The game's own Shift-JIS tables, so text written by the tool decodes
         back through the game's decoder unchanged. -->
    <Compile Include="..\OpenFF\Sjis.cs" Link="Formats\Sjis.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The editor serves these; they have to sit next to the exe. -->
    <None Include="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="10.0.12" />
  </ItemGroup>

</Project>
